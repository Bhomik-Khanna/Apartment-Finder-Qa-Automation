@'
# ---- Secrets: NEVER commit ----
.env
.env.*
!.env.example
.streamlit/secrets.toml
**/.streamlit/secrets.toml
secrets.toml
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/

# ---- Test and coverage output ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
reports/
test-results/
test-results-*.xml
junit*.xml
playwright-report/

# ---- Local databases ----
*.db
*.sqlite
*.sqlite3

# ---- Logs ----
*.log

# ---- Editors and OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Private notes ----
INTERVIEW_PREP.md
GITHUB_PUSH_GUIDE.md
inventory.txt
'@ | Set-Content -Path .gitignore -Encoding ascii